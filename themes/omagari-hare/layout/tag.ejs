<div class="ba-tag-page">
  <section class="ba-section">
    <h2 class="ba-section-title">
      <span class="ba-title-zh">标签</span>
      <span class="ba-title-en">Tags</span>
    </h2>

    <!-- 标签云 -->
    <div class="ba-tag-cloud cascade-up">
      <% site.tags.sort('length', -1).each(function(tag) { %>
      <a href="#<%= tag.name %>" class="tag-pill" style="font-size:<%= Math.min(1.4, 0.8 + tag.length / site.posts.length * 1.5) %>rem">
        #<%= tag.name %> (<%= tag.length %>)
      </a>
      <% }); %>
    </div>

    <!-- 每个标签的文章列表 -->
    <% site.tags.sort('length', -1).each(function(tag) { %>
    <div class="ba-tag-section" id="<%= tag.name %>">
      <h3 class="ba-tag-heading">
        <i class="fas fa-hashtag"></i> <%= tag.name %>
        <span class="ba-tag-count"><%= tag.length %> 篇</span>
      </h3>
      <div class="ba-tag-posts cascade-list">
        <% tag.posts.sort('date', -1).each(function(post) { %>
        <div class="ba-tag-post-item ba-card">
          <span class="ba-archive-date"><%= date(post.date, 'YYYY-MM-DD') %></span>
          <a href="<%= url_for(post.path) %>"><%= post.title %></a>
          <% if (post.categories.length) { %>
          <span class="ba-post-category ba-cat-<%= post.categories.first().name %>"><%= post.categories.first().name === 'tech' ? '技术' : '随记' %></span>
          <% } %>
        </div>
        <% }); %>
      </div>
    </div>
    <% }); %>
  </section>
</div>