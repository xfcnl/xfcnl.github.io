@font-face
  font-family 'Montserrat'
  src url('https://cdn.jsdelivr.net/gh/xfcnl/ba-assets@main/Montserrat.ttf') format('truetype')
  font-weight 100 900
  font-style normal
  font-display swap

@font-face
  font-family 'Baloo 2'
  src url('https://cdn.jsdelivr.net/gh/xfcnl/ba-assets@main/Baloo2.ttf') format('truetype')
  font-weight 400 800
  font-style normal
  font-display swap

@font-face
  font-family 'Bungee'
